{
  "manifest_version": 3,
  "name": "Lexi Scribe",
  "version": "1.0.0",
  "description": "AI medical scribe for every patient conversation",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "*://meet.google.com/*",
    "*://*.zoom.us/*",
    "*://teams.microsoft.com/*",
    "*://teams.live.com/*",
    "*://*.webex.com/*",
    "*://whereby.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "*://meet.google.com/*",
      "*://*.zoom.us/*",
      "*://teams.microsoft.com/*",
      "*://teams.live.com/*",
      "*://*.webex.com/*"
    ],
    "js": ["config.js", "content.js"],
    "css": ["sidebar.css"]
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
